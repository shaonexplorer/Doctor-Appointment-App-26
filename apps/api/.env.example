# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doctor_appointment?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# BetterAuth
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars-change-in-production"
BETTER_AUTH_URL="http://localhost:4000"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Server
PORT=4000
NODE_ENV=development

# Email (configure for production)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@doctor-appointment.app"